fun sayHi(first, last) {
  print "Hi, " + first + " " + last + "!";
}

sayHi("Dear", "Reader");
print sayHi;

fun fib(n) {
  if (n <= 1) return n;
  return fib(n - 2) + fib(n - 1);
}

for (var i = 0; i < 20; i = i + 1) {
  print fib(i);
}

var x = clock();
sleep(1);
var elapsed = (clock() - x);
print(elapsed > 1 and elapsed < 2);
print(clock);
